NODE_ENV=development
LOG_LEVEL=info
# Railway sets PORT automatically.
PORT=3000
HOST=0.0.0.0
# Server-side connection to Supabase Postgres (bypasses RLS) – never expose to the PWA.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# Requests per minute on /ingest/* for one device token and for one IP address.
INGEST_RATE_LIMIT_PER_TOKEN=120
INGEST_RATE_LIMIT_PER_IP=240
# Supabase project URL: /push/* verifies user sessions against its JWKS. Without it push answers 503.
SUPABASE_URL=https://<project-ref>.supabase.co
# Only for projects still on the legacy HS256 JWT secret (otherwise leave unset).
# SUPABASE_JWT_SECRET=
# PWA origin(s) allowed to call /push/* from the browser, comma-separated.
PWA_ORIGIN=http://localhost:5173
