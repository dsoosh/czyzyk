NODE_ENV=development
LOG_LEVEL=info
# Railway sets PORT automatically.
PORT=3000
HOST=0.0.0.0
# Server-side connection to Supabase Postgres (bypasses RLS) – never expose to the PWA.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# Requests per minute on /ingest/* for one device token and for one IP address.
INGEST_RATE_LIMIT_PER_TOKEN=120
INGEST_RATE_LIMIT_PER_IP=240
