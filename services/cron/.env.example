NODE_ENV=development
LOG_LEVEL=info
# Server-side connection to Supabase Postgres (session pooler, port 5432) – same database as worker.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# VAPID key pair: npm run vapid:generate -w @czyzyk/cron
# The public key also goes to the PWA as VITE_VAPID_PUBLIC_KEY; the private key never leaves this service.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services (mailto: or https://).
VAPID_SUBJECT=mailto:rodzina@example.com
# A digest missed at its hour (e.g. during a restart) may still go out within this many minutes.
DIGEST_WINDOW_MINUTES=120
