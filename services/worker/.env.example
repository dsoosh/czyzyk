NODE_ENV=development
LOG_LEVEL=info
# Direct (session) connection to Supabase Postgres – Project Settings → Database.
# Never expose this value to the PWA.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
HEALTH_LOG_INTERVAL_SECONDS=300

# Claude (Anthropic) – server-side only.
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
# Model for extraction and triage (spec: Claude Haiku). Model names live only in configuration.
EXTRACTION_MODEL=claude-haiku-4-5
# Seconds between a new message and its extraction; messages arriving meanwhile join the same run.
EXTRACTION_DELAY_SECONDS=15
# Items extracted with lower confidence get status needs_review (hidden until approved).
EXTRACTION_CONFIDENCE_THRESHOLD=0.7
# Earlier, already processed messages given to the model as context.
EXTRACTION_CONTEXT_MESSAGES=50
