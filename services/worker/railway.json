{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build -w @czyzyk/shared && npm run build -w @czyzyk/worker",
    "watchPatterns": ["services/worker/**", "packages/shared/**", "package-lock.json"]
  },
  "deploy": {
    "startCommand": "npm run start -w @czyzyk/worker",
    "restartPolicyType": "ALWAYS"
  }
}
