{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build",
    "watchPatterns": [
      "services/worker/**",
      "packages/shared/**",
      "package-lock.json"
    ]
  },
  "deploy": {
    "startCommand": "npm start",
    "restartPolicyType": "ALWAYS"
  }
}
