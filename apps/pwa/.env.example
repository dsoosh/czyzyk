# Public values only – everything here ends up in the browser bundle.
# Supabase → Project Settings → API: Project URL and the anon (public) key.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=replace-with-anon-key
# Public URL of services/api (Railway domain) – used in the phone pairing link.
VITE_API_URL=http://localhost:3000
# Public VAPID key (cron VAPID_PUBLIC_KEY) – lets the browser subscribe to push.
VITE_VAPID_PUBLIC_KEY=
