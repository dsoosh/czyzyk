{
  "name": "@czyzyk/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./extraction": {
      "types": "./dist/extraction.d.ts",
      "default": "./dist/extraction.js"
    },
    "./chat-export": {
      "types": "./dist/chatExport.d.ts",
      "default": "./dist/chatExport.js"
    },
    "./assistant": {
      "types": "./dist/assistant.d.ts",
      "default": "./dist/assistant.js"
    },
    "./prompts": {
      "types": "./dist/prompts.d.ts",
      "default": "./dist/prompts.js"
    },
    "./contacts": {
      "types": "./dist/contacts.d.ts",
      "default": "./dist/contacts.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.1.0"
  }
}
